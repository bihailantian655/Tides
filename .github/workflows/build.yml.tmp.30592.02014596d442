name: Build

on:
  push:
    branches: [main]
  workflow_dispatch:

jobs:
  build-windows:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20

      - uses: dtolnay/rust-toolchain@stable

      - name: Cache Rust
        uses: actions/cache@v4
        with:
          path: |
            ~/.cargo/bin/
            ~/.cargo/registry/index/
            ~/.cargo/registry/cache/
            ~/.cargo/git/db/
            src-tauri/target/
          key: ${{ runner.os }}-cargo-${{ hashFiles('**/Cargo.lock') }}
          restore-keys: ${{ runner.os }}-cargo-

      - run: npm install

      - name: Diagnose and fix alloc-no-stdlib version conflict
        working-directory: src-tauri
        run: |
          cargo generate-lockfile
          echo "=== Crates depending on alloc-no-stdlib ==="
          cargo tree -i alloc-no-stdlib -f "{p} {r}" 2>&1 || true
          echo ""
          echo "=== Checking if alloc-no-stdlib v3 is present ==="
          grep -c "alloc-no-stdlib" Cargo.lock 2>/dev/null || true
          grep -A3 'name = "alloc-no-stdlib"' Cargo.lock 2>/dev/null || true
          echo ""
          echo "=== Checking alloc-stdlib versions ==="
          grep -A3 'name = "alloc-stdlib"' Cargo.lock 2>/dev/null || true
          echo ""
          echo "=== Attempting to force alloc-no-stdlib@2.0.4 only ==="
          # Try to update the v3 entry if it exists; fail gracefully
          cargo update -p alloc-no-stdlib@2.0.4 --precise 2.0.4 2>&1 || true
          # If v3 exists, try to find its parent and update
          if grep -q 'alloc-no-stdlib.*3\.0\.0' Cargo.lock 2>/dev/null; then
            echo "WARNING: alloc-no-stdlib 3.0.0 detected in lockfile!"
            echo "Finding reverse deps..."
            cargo tree -i alloc-no-stdlib@3.0.0 -f "{p} {r}" 2>&1 || true
          fi

      - name: Build
        run: npx tauri build

      - name: Upload exe
        uses: actions/upload-artifact@v4
        with:
          name: MobileBrowser-windows
          path: |
            src-tauri/target/release/bundle/nsis/*.exe
            src-tauri/target/release/MobileBrowser.exe
          if-no-files-found: error
